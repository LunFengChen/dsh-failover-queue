{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/src/index.ts"],
      "@deepseek-ai/cosmokit": ["../deepseek-harness/vendor/cosmokit/src/index.ts"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
